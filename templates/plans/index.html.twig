{% extends 'base/layout.html.twig' %}
{% block title %}Plans - Running Tracker{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shell.css') }}?v=20260521-mobile1">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=20260616-p2p5">
<link rel="stylesheet" href="{{ asset('css/plans.css') }}?v=20260616-p2p5">
{% endblock %}

{% block body %}
{% include 'components/_app_header.html.twig' with { current_page: 'plans', username: username } %}

<main>
  <section id="plans" class="visible" data-initial-plan-id="">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="section-sub" style="margin:8px 0; color: {{ label == 'error' ? 'var(--accent3)' : 'var(--z1)' }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    <div id="plans-list-header">
      <div class="section-title">Mes plans</div>
      <div class="section-sub">
        {% if hasExamplePlan %}
          Un plan exemple est fourni. Ajoute ensuite tes plans personnels.
        {% else %}
          Gère ici tes plans personnels.
        {% endif %}
      </div>
    </div>

    {% if requestedPlanNotFound %}
      <div class="section-sub" style="margin:12px 0">Le plan demandé est introuvable.</div>
    {% endif %}

    <div id="plans-list" class="plans-list">
      {% for plan in plansView %}
        <article class="plan-card">
          <div class="plan-card-head">
            <div class="plan-card-main">
              <div class="plan-card-title">{{ plan.title }}</div>
              <div class="plan-card-sub">{{ plan.sub }}</div>
            </div>
            <div class="plan-card-stats">
              <div class="plan-card-pct">{% if plan.pct >= 100 or plan.completed %}Terminé{% else %}{{ plan.pct }}%{% endif %}</div>
              <div class="plan-card-count">{{ plan.done }}/{{ plan.total }} séances</div>
            </div>
            <form method="post" action="{{ path('app_plans_delete', { planId: plan.id }) }}" onsubmit="return confirm('Supprimer ce plan ?');" style="display:inline-flex">
              <input type="hidden" name="_token" value="{{ csrf_token('plans.delete.' ~ plan.id) }}">
              <button class="plan-card-delete" type="submit" title="Supprimer ce plan">🗑</button>
            </form>
            <a class="plan-card-arrow" href="{{ path('app_plans_detail', { planId: plan.id }) }}" aria-label="Ouvrir {{ plan.title }}">›</a>
          </div>
          <div class="plan-card-bar-bg">
            <div class="plan-card-bar" style="width:{{ plan.pct }}%"></div>
          </div>
        </article>
      {% else %}
        <div class="section-sub">Aucun plan disponible.</div>
      {% endfor %}
    </div>

    <div id="plans-done-section">
      <div class="plans-done-header">Terminés</div>
      <div id="plans-done-list" class="plans-list"></div>
    </div>

    <form id="plans-create-form" method="post" action="{{ path('app_plans_create') }}" class="form-card" data-collapsible-form="plans-add">
      <input type="hidden" name="_token" value="{{ csrf_token('plans.create') }}">
      <div class="form-card-head"><h3>➕ Créer un plan</h3></div>
      <div class="form-grid form-grid-single">
        <div class="field">
          <label for="plans-create-name">Nom du plan</label>
          <input id="plans-create-name" type="text" name="name" maxlength="64" placeholder="Ex: Mon Premier Semi" required>
        </div>
      </div>
      <div class="modal-actions" style="margin-top:10px; justify-content:flex-start;">
        <button class="btn" type="submit">Créer un plan</button>
      </div>
    </form>

    <template id="plan-card-template">
      <article class="plan-card">
        <div class="plan-card-head">
          <div class="plan-card-main">
            <div class="plan-card-title"></div>
            <div class="plan-card-sub"></div>
          </div>
          <div class="plan-card-stats">
            <div class="plan-card-pct"></div>
            <div class="plan-card-count"></div>
          </div>
          <button class="plan-card-delete" title="Supprimer ce plan">🗑</button>
          <a class="plan-card-arrow" href="#">›</a>
        </div>
        <div class="plan-card-bar-bg">
          <div class="plan-card-bar"></div>
        </div>
      </article>
    </template>
  </section>
</main>

<div class="notif" id="notif"></div>
<div class="confirm-overlay" id="confirm-overlay">
  <div class="modal">
    <div class="modal-title" id="confirm-title">Confirmation</div>
    <div id="confirm-msg"></div>
    <div class="modal-actions">
      <button class="btn" onclick="confirmDelete()">Confirmer</button>
      <button class="btn btn-ghost" onclick="closeConfirm()">Annuler</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="newplan-modal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('newplan-modal')">✕</button>
    <div class="modal-title">Nouveau plan</div>
    <div class="form-grid form-grid-single">
      <div class="field"><label for="np-title">Nom du plan</label><input type="text" id="np-title" placeholder="Ex: 10 km automne"></div>
    </div>
    <div class="modal-actions">
      <button class="btn" onclick="confirmCreatePlan()">Créer</button>
      <button class="btn btn-ghost" onclick="closeModal('newplan-modal')">Annuler</button>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/app.js') }}?v=20260811-merge1"></script>
{% endblock %}
