{% extends 'base/layout.html.twig' %}
{% block title %}Courses - Running Tracker{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shell.css') }}?v=20260521-mobile1">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=20260616-p2p4">
<link rel="stylesheet" href="{{ asset('css/courses.css') }}?v=20260607-dnf-mobile3">
{% endblock %}

{% block body %}
{% include 'components/_app_header.html.twig' with { current_page: 'courses', username: username } %}

<main>
  <section id="courses" class="visible">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="section-sub" style="margin:8px 0; color: {{ label == 'error' ? 'var(--accent3)' : 'var(--z1)' }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    <div class="section-title">Calendrier des courses</div>
    <div class="section-sub">Saison 2026</div>
    <form class="form-card" method="post" action="{{ path('app_courses_create') }}" data-collapsible-form="courses-add">
      <input type="hidden" name="_token" value="{{ csrf_token('courses.create') }}">
      <h3>➕ Ajouter une course</h3>
      <div class="form-grid">
        <div class="field"><label for="r-name">Nom</label><input type="text" id="r-name" name="name" placeholder="10km de Paris"></div>
        <div class="field"><label for="r-date">Date</label><input type="date" id="r-date" name="date" placeholder="jj/mm/yyyy"></div>
        <div class="field"><label for="r-dist">Distance (km)</label><input type="text" id="r-dist" name="distance" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" placeholder="10"></div>
        <div class="field"><label for="r-obj">Objectif (min ou hh:mm:ss)</label><input type="text" id="r-obj" name="objective" placeholder="00:55:00"></div>
        <div class="field"><label for="r-real">Résultat</label><input type="text" id="r-real" name="result" placeholder="00:53:22"></div>
      </div>
      <button class="btn" type="submit">Ajouter</button>
    </form>
    <div class="table-wrap">
      <table>
        <thead><tr><th class="sortable" data-sort-key="status">Échéance<span class="sort-ind"></span></th><th class="sortable" data-sort-key="name">Course<span class="sort-ind"></span></th><th class="sortable" data-sort-key="date">Date<span class="sort-ind"></span></th><th class="sortable" data-sort-key="distance">Distance<span class="sort-ind"></span></th><th class="sortable" data-sort-key="objective">Objectif<span class="sort-ind"></span></th><th class="sortable" data-sort-key="result">Résultat<span class="sort-ind"></span></th><th class="sortable" data-sort-key="delta">Écart<span class="sort-ind"></span></th><th></th></tr></thead>
        <tbody id="races-tbody">
          {% for r in racesView|default([]) %}
            <tr>
              <td class="races-status" data-label=""><span class="badge {{ r.statusClass }}">{{ r.statusLabel }}</span></td>
              <td data-label="Course"><strong class="races-name">{{ r.name }}</strong></td>
              <td class="mono races-date" data-label="Date">{{ r.date|date('d M Y') }}</td>
              <td class="races-dist" data-label="Distance">{{ r.distance ?: '—' }}</td>
              <td class="mono races-obj" data-label="Objectif">{{ r.objective ?: '—' }}</td>
              <td class="mono races-real" data-label="Résultat">{{ r.result ?: '—' }}</td>
              <td class="mono races-diff" data-label="Écart">{% if r.dnfStatus in ['dns', 'dnf'] %}{{ r.dnfComment ?: '—' }}{% else %}{{ r.resultDelta }}{% endif %}</td>
              <td class="races-actions" data-label="">
                <div class="action-btns" style="opacity:1; display:flex; gap:6px; justify-content:flex-end;">
                  <details>
                    <summary class="action-btn action-btn-text" style="cursor:pointer; list-style:none;">Modifier</summary>
                    <form method="post" action="{{ path('app_courses_update', { id: r.id }) }}" style="margin-top:8px; min-width:360px; padding:10px; border:1px solid var(--line); border-radius:12px; background:var(--panel); display:grid; gap:8px;">
                      <input type="hidden" name="_token" value="{{ csrf_token('courses.update.' ~ r.id) }}">
                      <div class="form-grid">
                        <div class="field"><label>Nom</label><input type="text" name="name" value="{{ r.name }}" required></div>
                        <div class="field"><label>Date</label><input type="date" name="date" value="{{ r.date }}" required></div>
                        <div class="field"><label>Distance</label><input type="text" name="distance" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" value="{{ r.distance ?: '' }}"></div>
                        <div class="field"><label>Objectif</label><input type="text" name="objective" value="{{ r.objective ?: '' }}" placeholder="hh:mm:ss"></div>
                      </div>
                      <div style="display:flex; gap:6px; justify-content:flex-end;">
                        <button class="action-btn action-btn-text" type="submit">Sauver</button>
                      </div>
                    </form>
                  </details>
                  <form method="post" action="{{ path('app_courses_result', { id: r.id }) }}" style="display:inline-flex; gap:6px;">
                    <input type="hidden" name="_token" value="{{ csrf_token('courses.result.' ~ r.id) }}">
                    <input type="text" name="result" value="{{ r.result ?: '' }}" placeholder="hh:mm:ss" style="width:92px;">
                    <button class="action-btn action-btn-text races-result" type="submit" title="Enregistrer résultat">Résultat</button>
                  </form>
                  <form method="post" action="{{ path('app_courses_delete', { id: r.id }) }}" onsubmit="return confirm('Supprimer cette course ?');" style="display:inline-flex;">
                    <input type="hidden" name="_token" value="{{ csrf_token('courses.delete.' ~ r.id) }}">
                    <button class="action-btn del races-delete" type="submit">🗑</button>
                  </form>
                  {% if r.dnfStatus in ['dns', 'dnf'] or r.result %}
                  <form method="post" action="{{ path('app_courses_reset', { id: r.id }) }}" onsubmit="return confirm('Réinitialiser le statut de cette course ?');" style="display:inline-flex;">
                    <input type="hidden" name="_token" value="{{ csrf_token('courses.reset.' ~ r.id) }}">
                    <button class="action-btn action-btn-text races-reset" type="submit" title="Réinitialiser le statut">↺ Reset</button>
                  </form>
                  {% endif %}
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <template id="races-row-template">
        <tr>
          <td class="races-status" data-label=""></td>
          <td data-label="Course"><strong class="races-name"></strong></td>
          <td class="mono races-date" data-label="Date"></td>
          <td class="races-dist" data-label="Distance"></td>
          <td class="mono races-obj" data-label="Objectif"></td>
          <td class="mono races-real" data-label="Résultat"></td>
          <td class="mono races-diff" data-label="Écart"></td>
          <td class="races-actions" data-label="">
            <div class="action-btns">
              <button class="action-btn action-btn-text races-result" title="Saisir résultat">Résultat</button>
              <button class="action-btn action-btn-text races-edit" title="Modifier la course">Modifier</button>
              <button class="action-btn action-btn-text races-reset" title="Réinitialiser le statut" hidden>↺ Reset</button>
              <button class="action-btn del races-delete">🗑</button>
            </div>
          </td>
        </tr>
      </template>
      <template id="races-status-badge-template">
        <span class="badge"></span>
      </template>
    </div>
  </section>
</main>

<div class="notif" id="notif"></div>
<div class="confirm-overlay" id="confirm-overlay">
  <div class="modal">
    <div class="modal-title" id="confirm-title">Confirmation</div>
    <div id="confirm-msg"></div>
    <div class="modal-actions">
      <button class="btn" onclick="confirmDelete()">Confirmer</button>
      <button class="btn btn-ghost" onclick="closeConfirm()">Annuler</button>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/app.js') }}?v=20260811-merge1"></script>
<script>
  // Distance: chiffres uniquement (un seul séparateur décimal). Délégation pour les formulaires d'édition créés dynamiquement.
  document.addEventListener('input', function (e) {
    var t = e.target;
    if (!t || t.name !== 'distance') return;
    var cleaned = String(t.value).replace(/[^0-9.,]/g, '').replace(/[.,]/, '\x00').replace(/[.,]/g, '').replace('\x00', '.');
    if (cleaned !== t.value) t.value = cleaned;
  }, true);
</script>
{% endblock %}
