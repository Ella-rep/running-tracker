{% extends 'base/layout.html.twig' %}

{% block title %}Erreur inattendue{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/error-pages.css') }}?v=20260529-error1">
{% endblock %}

{% block body %}
<main class="error-page-main">
  <section class="error-page-card">
    <p class="error-page-code">Erreur</p>
    <h1 class="error-page-title">Une erreur inattendue est survenue</h1>
    <p class="error-page-text">La page demandee n est pas disponible pour le moment. Vous pouvez revenir a l accueil ou reessayer un peu plus tard.</p>
    <div class="error-page-actions">
      <a class="btn" href="/">Retour a l accueil</a>
      <a class="btn btn-ghost" href="/login">Aller a la connexion</a>
    </div>
  </section>
</main>
{% endblock %}

{% block javascripts %}
  <script>
    document.body.classList.add('error-page-body');
  </script>
{% endblock %}
