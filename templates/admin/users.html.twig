{% extends 'base/layout.html.twig' %}
{% block title %}Admin - Utilisateurs{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shell.css') }}?v=20260521-mobile1">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=20260616-p2p4">
<link rel="stylesheet" href="{{ asset('css/admin.css') }}?v=20260529-userscard1">
{% endblock %}

{% block body %}
{% include 'components/_app_header.html.twig' with { current_page: current_page, username: username } %}
{% set k = kpis|default({}) %}

<main>
  <section class="admin-users-page visible">
    <div class="section-title">Administration utilisateurs</div>
    <div class="section-sub">Gestion directe des comptes, supervision operationnelle, communication globale et securite des actions critiques.</div>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="admin-flash admin-flash-{{ label == 'error' ? 'error' : 'success' }}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    <div class="admin-kpi-grid">
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Utilisateurs totaux</div>
        <div class="admin-kpi-value">{{ k.total_users|default(0) }}</div>
        <div class="admin-kpi-sub">+{{ k.new_users_24h|default(0) }} sur 24h · +{{ k.new_users_7d|default(0) }} sur 7 jours</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Runners actifs (7j)</div>
        <div class="admin-kpi-value">{{ k.active_runners_7d|default(0) }}</div>
        <div class="admin-kpi-sub">{{ k.engagement_rate_7d|default(0) }}% d engagement · {{ k.inactive_users_7d|default(0) }} inactifs</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Completion plans</div>
        <div class="admin-kpi-value">{{ k.plan_rate|default(0) }}%</div>
        <div class="admin-kpi-sub">{{ k.plan_done|default(0) }} / {{ k.plan_total|default(0) }} plans termines</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Plans ajoutes</div>
        <div class="admin-kpi-value">{{ k.plans_total|default(0) }}</div>
        <div class="admin-kpi-sub">{{ k.plans_tracked|default(0) }} suivis dashboard · {{ k.plans_untracked|default(0) }} inactifs</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Adoption plan users</div>
        <div class="admin-kpi-value">{{ k.plan_adoption_rate|default(0) }}%</div>
        <div class="admin-kpi-sub">{{ k.users_with_plans|default(0) }} users avec plan · {{ k.users_following_plans|default(0) }} avec progression done</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Suivi plan inactif</div>
        <div class="admin-kpi-value">{{ k.users_inactive_plan_progress|default(0) }}</div>
        <div class="admin-kpi-sub">users avec progression commencée mais jamais terminee</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Actions user (7j)</div>
        <div class="admin-kpi-value">{{ k.user_actions_7d_total|default(0) }}</div>
        <div class="admin-kpi-sub">Creations: {{ k.user_creates_7d|default(0) }} · Resets: {{ k.password_resets_7d|default(0) }} · Suppressions: {{ k.user_deletions_7d|default(0) }} · {{ k.run_logs_7d|default(0) }} logs</div>
      </article>
      <article class="chart-wrap admin-kpi-card">
        <div class="chart-title">Action dominante (7j)</div>
        <div class="admin-kpi-value admin-kpi-value-sm">{{ k.top_action_7d_label|default('Aucune action') }}</div>
        <div class="admin-kpi-sub">{{ k.top_action_7d_count|default(0) }} occurrences</div>
      </article>
    </div>

    <div class="chart-wrap admin-feature-usage-card">
      <div class="chart-title">Utilisation des fonctionnalites (users)</div>
      <div class="admin-feature-usage-list">
        {% for feature in feature_usage|default([]) %}
          {% set feature_total = feature.used + feature.unused %}
          {% set feature_used_rate = feature_total > 0 ? ((feature.used * 100 / feature_total)|round(1)) : 0 %}
          <div class="admin-feature-usage-row">
            <span class="admin-feature-name">{{ feature.name }}</span>
            <span class="admin-feature-stat">Utilise: <strong>{{ feature.used }}</strong></span>
            <span class="admin-feature-stat">Non utilise: <strong>{{ feature.unused }}</strong></span>
            <svg class="admin-feature-graph" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
              <rect class="admin-feature-graph-bg" x="0" y="0" width="100" height="8"></rect>
              <rect class="admin-feature-graph-fill" x="0" y="0" width="{{ feature_used_rate }}" height="8"></rect>
            </svg>
            <span class="admin-feature-graph-label">{{ feature_used_rate }}% utilises</span>
          </div>
        {% else %}
          <div class="admin-feature-usage-row">
            <span class="admin-feature-name">Aucune donnee d usage disponible pour le moment.</span>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="chart-wrap admin-alerts-card">
      <div class="chart-title">Alertes operationnelles</div>
      <div class="admin-alert-list">
        {% for alert in alerts %}
          <article class="admin-alert admin-alert-{{ alert.level }}">
            <strong>{{ alert.title }}</strong>
            <p>{{ alert.message }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
    

    <div class="chart-wrap admin-maintenance-card">
      <div class="chart-title">Maintenance</div>
      <div class="admin-maintenance-section">
        <h4>Rapport erreurs Gmail/OAuth</h4>
        <p class="admin-maintenance-desc">Collecte les erreurs OAuth Google des logs récents et envoie un rapport détaillé à l'adresse interne de contact.</p>
        <button id="admin-gmail-report-btn" class="btn btn-ghost" onclick="adminSendGmailErrorReport()">Envoyer rapport Gmail</button>
        <div id="admin-gmail-report-status" style="margin-top:12px;"></div>
      </div>
      <div class="admin-maintenance-section" style="margin-top:18px;">
        <h4>Importer les courses terminées dans les logs</h4>
        <p class="admin-maintenance-desc">Crée une sortie (type Course) pour chaque course officielle déjà terminée qui n'a pas encore de log correspondant. Les logs existants ne sont jamais modifiés.</p>
        <button id="admin-backfill-races-btn" class="btn btn-ghost" onclick="adminBackfillRaceLogs()">Importer les courses</button>
        <div id="admin-backfill-races-status" style="margin-top:12px;"></div>
      </div>
    </div>

    <div class="chart-wrap admin-announce-card">
      <div class="chart-title">Centre de communication</div>
      {% if latest_announcement %}
        <p class="admin-announce-current">
          Derniere annonce: <strong class="admin-announce-current-title">{{ latest_announcement.title ?: 'Annonce' }}</strong>
          <span class="admin-announce-current-message">{{ latest_announcement.message|e|nl2br }}</span>
          (niveau {{ latest_announcement.level }},
          {{ latest_announcement.isActive ? 'active' : 'inactive' }})
        </p>
      {% endif %}

      <form method="post" action="{{ path('app_admin_announcement_upsert', { q: search_query, page: page }) }}" class="admin-announce-form">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_announcement_upsert') }}">
        <label class="admin-field">
          <span>Titre annonce</span>
          <input type="text" name="title" maxlength="120" value="{{ latest_announcement and latest_announcement.title ? latest_announcement.title : 'Annonce' }}" placeholder="Annonce">
        </label>
        <label class="admin-field admin-announce-message">
          <span>Message global</span>
          <textarea name="message" minlength="6" maxlength="800" required>{{ latest_announcement ? latest_announcement.message : '' }}</textarea>
        </label>
        <label class="admin-field">
          <span>Niveau</span>
          <select name="level">
            {% set selected_level = latest_announcement ? latest_announcement.level : 'info' %}
            {% if selected_level == 'critical' %}
              {% set selected_level = 'danger' %}
            {% endif %}
            <option value="success" {{ selected_level == 'success' ? 'selected' : '' }}>Success</option>
            <option value="info" {{ selected_level == 'info' ? 'selected' : '' }}>Info</option>
            <option value="warning" {{ selected_level == 'warning' ? 'selected' : '' }}>Warning</option>
            <option value="danger" {{ selected_level == 'danger' ? 'selected' : '' }}>Danger</option>
          </select>
        </label>
        <label class="admin-field">
          <span>Debut (optionnel)</span>
          <input type="datetime-local" name="starts_at" value="{{ latest_announcement and latest_announcement.startsAt ? latest_announcement.startsAt|date('Y-m-d\\TH:i') : '' }}">
        </label>
        <label class="admin-field">
          <span>Fin (optionnel)</span>
          <input type="datetime-local" name="ends_at" value="{{ latest_announcement and latest_announcement.endsAt ? latest_announcement.endsAt|date('Y-m-d\\TH:i') : '' }}">
        </label>
        <label class="admin-check">
          <input type="checkbox" name="is_active" value="1" {{ latest_announcement is null or latest_announcement.isActive ? 'checked' : '' }}>
          <span>Annonce active</span>
        </label>
        <button type="submit" class="btn">Enregistrer annonce</button>
      </form>

      <form method="post" action="{{ path('app_admin_announcement_deactivate', { q: search_query, page: page }) }}" class="admin-announce-off-form" onsubmit="return confirm('Desactiver la banniere globale ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_announcement_deactivate') }}">
        <button type="submit" class="btn btn-ghost">Desactiver annonce</button>
      </form>
    </div>

    <div class="chart-wrap admin-create-card">
      <div class="chart-title">Creer un utilisateur</div>
      <form method="post" action="{{ path('app_admin_users_create', { q: search_query, page: page }) }}" class="admin-create-form">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_create_user') }}">
        <label class="admin-field">
          <span>Pseudo</span>
          <input type="text" name="username" minlength="3" maxlength="64" required>
        </label>
        <label class="admin-field">
          <span>Email</span>
          <input type="email" name="email" required>
        </label>
        <label class="admin-field">
          <span>Mot de passe</span>
          <input type="password" name="password" minlength="6" required>
        </label>
        <label class="admin-check">
          <input type="checkbox" name="is_admin" value="1">
          <span>Donner role admin</span>
        </label>
        <button type="submit" class="btn">Creer</button>
      </form>
    </div>

    <div class="chart-wrap admin-search-card">
      <form method="get" action="{{ path('app_admin_users') }}" class="admin-search-form">
        <label class="admin-field admin-search-field">
          <span>Recherche (pseudo ou email)</span>
          <input type="text" name="q" value="{{ search_query }}" placeholder="ex: alice ou gmail.com">
        </label>
        <button type="submit" class="btn">Rechercher</button>
        <a class="btn btn-ghost" href="{{ path('app_admin_users') }}">Reset</a>
      </form>
    </div>

    <div class="table-wrap admin-users-table-wrap">
      <div class="table-header">Utilisateurs ({{ total_users }})</div>
      <table class="admin-users-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Pseudo</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Creation</th>
            <th>Reset mot de passe</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for user in users %}
          {% set is_admin = 'ROLE_ADMIN' in user.roles %}
          <tr>
            <td class="mono" data-label="ID">{{ user.id }}</td>
            <td data-label="Pseudo">{{ user.userIdentifier }}</td>
            <td data-label="Email">{{ user.email ?: '—' }}</td>
            <td data-label="Rôles">
              <span class="badge {{ is_admin ? 'admin-role' : 'user-role' }}">{{ is_admin ? 'ROLE_ADMIN' : 'ROLE_USER' }}</span>
            </td>
            <td class="mono" data-label="Création">{{ user.createdAt|date('d/m/Y H:i') }}</td>
            <td data-label="Reset mot de passe">
              <form method="post" action="{{ path('app_admin_users_reset_password', { id: user.id, q: search_query, page: page }) }}" class="admin-action-form admin-reset-form" onsubmit="return confirm('Reset mot de passe de cet utilisateur ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_reset_' ~ user.id) }}">
                <input type="password" name="new_password" minlength="6" placeholder="Nouveau mdp" required>
                <button class="action-btn action-btn-text" type="submit">Reset</button>
              </form>
            </td>
            <td data-label="Actions">
              <div class="action-btns admin-action-btns admin-action-stack">
                <button
                  type="button"
                  class="action-btn action-btn-text admin-user-kpi-btn"
                  data-user-id="{{ user.id }}"
                  data-user-name="{{ user.userIdentifier }}"
                >KPI</button>
                <form method="post" action="{{ path('app_admin_users_toggle_admin', { id: user.id, q: search_query, page: page }) }}" class="admin-action-form" onsubmit="return confirm('{{ is_admin ? 'Retirer le role admin de cet utilisateur ?' : 'Donner le role admin a cet utilisateur ?' }}');">
                  <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_' ~ user.id) }}">
                  <button class="action-btn action-btn-text" type="submit">{{ is_admin ? 'Retirer admin' : 'Passer admin' }}</button>
                </form>
                <form method="post" action="{{ path('app_admin_users_delete', { id: user.id, q: search_query, page: page }) }}" onsubmit="return confirm('Supprimer cet utilisateur ?');" class="admin-action-form">
                  <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_' ~ user.id) }}">
                  <button class="action-btn action-btn-text del" type="submit">Supprimer</button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="admin-empty">Aucun utilisateur.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

      <div class="admin-pagination">
        {% set prev_page = page > 1 ? page - 1 : 1 %}
        {% set next_page = page < total_pages ? page + 1 : total_pages %}
        <a class="btn btn-ghost {{ page <= 1 ? 'is-disabled' : '' }}" href="{{ path('app_admin_users', { q: search_query, page: prev_page }) }}" aria-disabled="{{ page <= 1 ? 'true' : 'false' }}">← Prec</a>
        <span>Page {{ page }} / {{ total_pages }}</span>
        <a class="btn btn-ghost {{ page >= total_pages ? 'is-disabled' : '' }}" href="{{ path('app_admin_users', { q: search_query, page: next_page }) }}" aria-disabled="{{ page >= total_pages ? 'true' : 'false' }}">Suiv →</a>
      </div>
    </div>

    <div class="table-wrap admin-audit-table-wrap">
      <div class="table-header">Historique admin ({{ audit_total }})</div>

      <form method="get" action="{{ path('app_admin_users') }}" class="admin-audit-search-form">
        <input type="hidden" name="q" value="{{ search_query }}">
        <input type="hidden" name="page" value="{{ page }}">
        <label class="admin-field">
          <span>Action</span>
          <select name="audit_action">
            <option value="">Toutes</option>
            {% for action_name in audit_actions %}
              <option value="{{ action_name }}" {{ audit_filters.action == action_name ? 'selected' : '' }}>{{ action_name }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="admin-field">
          <span>Admin</span>
          <input type="text" name="audit_admin" value="{{ audit_filters.admin }}" placeholder="ex: alice">
        </label>
        <label class="admin-field">
          <span>Depuis</span>
          <input type="date" name="audit_from" value="{{ audit_filters.from }}">
        </label>
        <label class="admin-field">
          <span>Jusqu a</span>
          <input type="date" name="audit_to" value="{{ audit_filters.to }}">
        </label>
        <button class="btn" type="submit">Filtrer</button>
        <a class="btn btn-ghost" href="{{ path('app_admin_users', { q: search_query, page: page }) }}">Reset</a>
        <a class="btn btn-ghost" href="{{ path('app_admin_users_audit_export', { audit_action: audit_filters.action, audit_admin: audit_filters.admin, audit_from: audit_filters.from, audit_to: audit_filters.to }) }}">Export CSV</a>
      </form>

      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Admin</th>
            <th>Action</th>
            <th>Cible user_id</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
        {% for log in audit_logs %}
          <tr>
            <td class="mono">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
            <td>{{ log.adminIdentifier }}</td>
            <td><span class="badge admin-action-badge">{{ log.action }}</span></td>
            <td class="mono">{{ log.targetUserId ?: '—' }}</td>
            <td class="mono admin-details-cell">{{ log.details|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="admin-empty">Aucun evenement audit.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>

      <div class="admin-pagination">
        {% set audit_prev_page = audit_page > 1 ? audit_page - 1 : 1 %}
        {% set audit_next_page = audit_page < audit_total_pages ? audit_page + 1 : audit_total_pages %}
        <a class="btn btn-ghost {{ audit_page <= 1 ? 'is-disabled' : '' }}" href="{{ path('app_admin_users', { q: search_query, page: page, audit_action: audit_filters.action, audit_admin: audit_filters.admin, audit_from: audit_filters.from, audit_to: audit_filters.to, audit_page: audit_prev_page }) }}" aria-disabled="{{ audit_page <= 1 ? 'true' : 'false' }}">← Prec</a>
        <span>Audit page {{ audit_page }} / {{ audit_total_pages }}</span>
        <a class="btn btn-ghost {{ audit_page >= audit_total_pages ? 'is-disabled' : '' }}" href="{{ path('app_admin_users', { q: search_query, page: page, audit_action: audit_filters.action, audit_admin: audit_filters.admin, audit_from: audit_filters.from, audit_to: audit_filters.to, audit_page: audit_next_page }) }}" aria-disabled="{{ audit_page >= audit_total_pages ? 'true' : 'false' }}">Suiv →</a>
      </div>
    </div>

    <div class="modal-overlay" id="admin-user-kpi-modal" aria-hidden="true">
      <div class="modal admin-user-kpi-modal">
        <button class="modal-close" type="button" onclick="closeAdminUserKpiModal()">✕</button>
        <div class="modal-title" id="admin-user-kpi-title">KPI utilisateur</div>
        <div id="admin-user-kpi-status" class="admin-user-kpi-status">Chargement…</div>
        <div class="admin-user-kpi-grid" id="admin-user-kpi-grid" hidden>
          <article class="admin-user-kpi-item">
            <h4>Plans</h4>
            <div id="admin-user-kpi-plans"></div>
          </article>
          <article class="admin-user-kpi-item">
            <h4>Logs</h4>
            <div id="admin-user-kpi-logs"></div>
          </article>
          <article class="admin-user-kpi-item">
            <h4>Courses</h4>
            <div id="admin-user-kpi-races"></div>
          </article>
          <article class="admin-user-kpi-item">
            <h4>Calendrier</h4>
            <div id="admin-user-kpi-calendar"></div>
          </article>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/app.js') }}?v=20260616-p2p4"></script>
<script>
async function adminSendGmailErrorReport() {
  const btn = document.getElementById('admin-gmail-report-btn');
  const status = document.getElementById('admin-gmail-report-status');
  if (!btn || !status) return;

  btn.disabled = true;
  btn.textContent = 'En cours...';
  status.innerHTML = '';

  try {
    const authHeaders = globalThis.rtAuth?.buildAuthHeaders ? globalThis.rtAuth.buildAuthHeaders() : {};

    const response = await fetch('/api/admin/maintenance/gmail-errors/report', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...authHeaders,
      },
      body: '{}',
    });

    let result;
    try {
      result = await response.json();
    } catch (e) {
      status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur ${response.status}:</strong> Réponse invalide (pas du JSON)</span>`;
      btn.disabled = false;
      btn.textContent = 'Envoyer rapport Gmail';
      return;
    }

    if (!response.ok) {
      status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur ${response.status}:</strong> ${result.message || 'Échec inconnu'}</span>`;
      btn.disabled = false;
      btn.textContent = 'Envoyer rapport Gmail';
      return;
    }

    const topCodes = result.codes && typeof result.codes === 'object'
      ? Object.entries(result.codes).slice(0, 3).map(([code, hits]) => `${code}: ${hits}`).join(' · ')
      : 'aucun code détaillé';

    status.innerHTML = `
      <div style="color:var(--z1);padding:12px;background:color-mix(in srgb, var(--z1) 16%, var(--surface2));border-radius:4px;">
        <strong>✓ Rapport envoyé</strong><br>
        Erreurs détectées (24h): ${result.errors || 0}<br>
        Codes: ${topCodes}
      </div>
    `;

    btn.disabled = false;
    btn.textContent = 'Envoyer rapport Gmail';
  } catch (e) {
    status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur reseau:</strong> ${e.message}</span>`;
    btn.disabled = false;
    btn.textContent = 'Envoyer rapport Gmail';
  }
}

async function adminBackfillRaceLogs() {
  const btn = document.getElementById('admin-backfill-races-btn');
  const status = document.getElementById('admin-backfill-races-status');
  if (!btn || !status) return;

  if (!confirm('Importer toutes les courses terminées manquantes dans les logs ?')) return;

  btn.disabled = true;
  btn.textContent = 'En cours...';
  status.innerHTML = '';

  try {
    const authHeaders = globalThis.rtAuth?.buildAuthHeaders ? globalThis.rtAuth.buildAuthHeaders() : {};

    const response = await fetch('/api/admin/maintenance/races/backfill-logs', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        ...authHeaders,
      },
      body: '{}',
    });

    let result;
    try {
      result = await response.json();
    } catch (e) {
      status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur ${response.status}:</strong> Réponse invalide (pas du JSON)</span>`;
      btn.disabled = false;
      btn.textContent = 'Importer les courses';
      return;
    }

    if (!response.ok) {
      status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur ${response.status}:</strong> ${result.message || 'Échec inconnu'}</span>`;
      btn.disabled = false;
      btn.textContent = 'Importer les courses';
      return;
    }

    status.innerHTML = `
      <div style="color:var(--z1);padding:12px;background:color-mix(in srgb, var(--z1) 16%, var(--surface2));border-radius:4px;">
        <strong>✓ Import terminé</strong><br>
        ${result.created || 0} course(s) ajoutée(s) aux logs<br>
        ${result.users || 0} utilisateur(s) concerné(s)
      </div>
    `;

    btn.disabled = false;
    btn.textContent = 'Importer les courses';
  } catch (e) {
    status.innerHTML = `<span style="color:var(--accent3);"><strong>Erreur reseau:</strong> ${e.message}</span>`;
    btn.disabled = false;
    btn.textContent = 'Importer les courses';
  }
}

function closeAdminUserKpiModal() {
  const overlay = document.getElementById('admin-user-kpi-modal');
  if (!(overlay instanceof HTMLElement)) return;
  overlay.classList.remove('open');
  overlay.setAttribute('aria-hidden', 'true');
}

function openAdminUserKpiModal() {
  const overlay = document.getElementById('admin-user-kpi-modal');
  if (!(overlay instanceof HTMLElement)) return;
  overlay.classList.add('open');
  overlay.setAttribute('aria-hidden', 'false');
}

function setAdminUserKpiStatus(message, isError = false) {
  const status = document.getElementById('admin-user-kpi-status');
  const grid = document.getElementById('admin-user-kpi-grid');
  if (!(status instanceof HTMLElement)) return;
  status.textContent = message;
  status.classList.toggle('is-error', isError);
  if (grid instanceof HTMLElement) {
    grid.hidden = true;
  }
}

function renderAdminUserKpi(data) {
  const grid = document.getElementById('admin-user-kpi-grid');
  const status = document.getElementById('admin-user-kpi-status');
  if (!(grid instanceof HTMLElement) || !(status instanceof HTMLElement)) return;

  const plans = data?.plans || {};
  const logs = data?.logs || {};
  const races = data?.courses || {};
  const calendar = data?.calendar || {};
  const activePlan = plans?.activePlan || null;

  const planStatusBadge = activePlan 
    ? `<span class="admin-user-kpi-badge">Plan actif: ${activePlan.name}</span>`
    : `<span class="admin-user-kpi-badge is-empty">Aucun plan en cours</span>`;

  const plansHtml = `
    <div class="admin-user-kpi-value">${plans.tracked || 0}</div>
    <div class="admin-user-kpi-sublabel">plans suivis</div>
    ${planStatusBadge}
    <div class="admin-user-kpi-breakdown">
      <div>Seances: <strong>${plans.sessionsDone || 0}/${plans.sessionsTotal || 0}</strong> (${plans.sessionRate || 0}%)</div>
    </div>
  `;

  const logsHtml = `
    <div class="admin-user-kpi-value">${logs.total || 0}</div>
    <div class="admin-user-kpi-sublabel">logs au total</div>
    <div class="admin-user-kpi-breakdown">
      <div>7j: <strong>${logs.logs7d || 0}</strong></div>
      <div>Km: <strong>${logs.totalKm || 0}</strong></div>
      <div>Dernier: <strong>${logs.lastDate || '—'}</strong></div>
    </div>
  `;

  const racesHtml = `
    <div class="admin-user-kpi-value">${races.total || 0}</div>
    <div class="admin-user-kpi-sublabel">courses planifiees</div>
    <div class="admin-user-kpi-breakdown">
      <div>Terminees: <strong>${races.completed || 0}</strong></div>
      <div>Planifiees: <strong>${races.planned || 0}</strong></div>
      <div>A venir: <strong>${races.upcoming || 0}</strong></div>
    </div>
  `;

  const calendarHtml = `
    <div class="admin-user-kpi-value">${calendar.events || 0}</div>
    <div class="admin-user-kpi-sublabel">evenements</div>
  `;

  const plansEl = document.getElementById('admin-user-kpi-plans');
  const logsEl = document.getElementById('admin-user-kpi-logs');
  const racesEl = document.getElementById('admin-user-kpi-races');
  const calendarEl = document.getElementById('admin-user-kpi-calendar');

  if (plansEl) {
    plansEl.innerHTML = '';
    const val = document.createElement('div');
    val.className = 'admin-user-kpi-value';
    val.textContent = plans.tracked || 0;
    plansEl.appendChild(val);

    const label = document.createElement('div');
    label.className = 'admin-user-kpi-sublabel';
    label.textContent = 'plans suivis';
    plansEl.appendChild(label);

    const badge = document.createElement('span');
    badge.className = activePlan ? 'admin-user-kpi-badge' : 'admin-user-kpi-badge is-empty';
    badge.textContent = activePlan ? `Plan actif: ${activePlan.name}` : 'Aucun plan en cours';
    plansEl.appendChild(badge);

    const breakdown = document.createElement('div');
    breakdown.className = 'admin-user-kpi-breakdown';
    breakdown.innerHTML = `<div>Seances: <strong>${plans.sessionsDone || 0}/${plans.sessionsTotal || 0}</strong> (${plans.sessionRate || 0}%)</div>`;
    plansEl.appendChild(breakdown);
  }

  if (logsEl) {
    logsEl.innerHTML = '';
    const val = document.createElement('div');
    val.className = 'admin-user-kpi-value';
    val.textContent = logs.total || 0;
    logsEl.appendChild(val);

    const label = document.createElement('div');
    label.className = 'admin-user-kpi-sublabel';
    label.textContent = 'logs total';
    logsEl.appendChild(label);

    const breakdown = document.createElement('div');
    breakdown.className = 'admin-user-kpi-breakdown';
    breakdown.innerHTML = `<div>7j: <strong>${logs.logs7d || 0}</strong></div><div>Km: <strong>${logs.totalKm || 0}</strong></div><div>Dernier: <strong>${logs.lastDate || '—'}</strong></div>`;
    logsEl.appendChild(breakdown);
  }

  if (racesEl) {
    racesEl.innerHTML = '';
    const val = document.createElement('div');
    val.className = 'admin-user-kpi-value';
    val.textContent = races.total || 0;
    racesEl.appendChild(val);

    const label = document.createElement('div');
    label.className = 'admin-user-kpi-sublabel';
    label.textContent = 'courses';
    racesEl.appendChild(label);

    const breakdown = document.createElement('div');
    breakdown.className = 'admin-user-kpi-breakdown';
    breakdown.innerHTML = `<div>Terminees: <strong>${races.completed || 0}</strong></div><div>Planifiees: <strong>${races.planned || 0}</strong></div><div>A venir: <strong>${races.upcoming || 0}</strong></div>`;
    racesEl.appendChild(breakdown);
  }

  if (calendarEl) {
    calendarEl.innerHTML = '';
    const val = document.createElement('div');
    val.className = 'admin-user-kpi-value';
    val.textContent = calendar.events || 0;
    calendarEl.appendChild(val);

    const label = document.createElement('div');
    label.className = 'admin-user-kpi-sublabel';
    label.textContent = 'evenements';
    calendarEl.appendChild(label);
  }

  status.textContent = '';
  status.classList.remove('is-error');
  grid.hidden = false;
}

async function loadAdminUserKpi(userId, username) {
  const title = document.getElementById('admin-user-kpi-title');
  if (title) {
    title.textContent = `KPI utilisateur · ${username}`;
  }

  setAdminUserKpiStatus('Chargement…');
  openAdminUserKpiModal();

  try {
    const response = await fetch(`/admin/users/${userId}/kpis`, {
      headers: {
        'Accept': 'application/json',
      },
    });

    if (!response.ok) {
      setAdminUserKpiStatus(`Erreur ${response.status} lors du chargement des KPI.`, true);
      return;
    }

    const payload = await response.json();
    renderAdminUserKpi(payload || {});
  } catch (e) {
    setAdminUserKpiStatus(`Erreur reseau: ${e?.message || 'inconnue'}`, true);
  }
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.admin-user-kpi-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const userId = Number.parseInt(btn.getAttribute('data-user-id') || '', 10);
      const username = String(btn.getAttribute('data-user-name') || 'utilisateur');
      if (!Number.isFinite(userId)) return;
      loadAdminUserKpi(userId, username);
    });
  });

  const overlay = document.getElementById('admin-user-kpi-modal');
  if (overlay) {
    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) {
        closeAdminUserKpiModal();
      }
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeAdminUserKpiModal();
    }
  });
});
</script>
{% endblock %}
