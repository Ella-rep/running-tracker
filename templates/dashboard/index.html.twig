{% extends 'base/layout.html.twig' %}
{% block title %}Dashboard - Running Tracker{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shell.css') }}?v=20260521-mobile1">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=20260513-components1">
  <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}?v=20260522-mobile24">
{% endblock %}

{% block body %}
{% include 'components/_app_header.html.twig' with { current_page: 'dashboard', username: username } %}

<main>
  <section id="dashboard" class="visible">
    <div class="section-title">
      Vue d'ensemble 🏃
    </div>
    <div class="section-sub" id="dash-date">Chargement…</div>

    <div class="kpi-grid" id="kpi-grid"></div>
    <template id="dashboard-kpi-template">
      <article class="kpi">
        <div class="kpi-label"></div>
        <div class="kpi-value"></div>
        <div class="kpi-unit"></div>
      </article>
    </template>

    {% set dashboard_widget_definitions = dashboard_widget_definitions|default([]) %}
    {% set dashboard_widget_state = dashboard_widget_state|default({}) %}
    <div class="widget-picker-wrap is-collapsed" id="widget-picker-wrap">
      <button type="button" class="widget-picker-toggle" id="widget-picker-toggle" aria-expanded="false" aria-controls="widget-picker">+ Ajouter des widgets</button>
      <div class="widget-picker-title">Ajouter un suivi au dashboard</div>
      <div class="widget-picker" id="widget-picker">
        {% for widget in dashboard_widget_definitions %}
          {% if widget.key != 'monthly_load' %}
            {% set enabled = dashboard_widget_state[widget.key]|default(false) %}
            <button
              type="button"
              class="widget-pick-card{% if enabled %} widget-pick-card--hidden{% endif %}"
              data-widget-pick="{{ widget.key }}"
              aria-label="Afficher {{ widget.label }}"
              title="Afficher {{ widget.label }}"
            >
              <span class="widget-pick-chip">+ Ajouter</span>
              <span class="widget-pick-label">{{ widget.label }}</span>
              <span class="widget-pick-description">{{ widget.description }}</span>
              <span class="widget-pick-cta">Cliquer pour afficher ce suivi</span>
            </button>
            <input
              type="checkbox"
              class="widget-toggle-checkbox-hidden"
              data-widget-toggle="{{ widget.key }}"
              {% if enabled %}checked{% endif %}
            >
          {% endif %}
        {% endfor %}
        <input
          type="checkbox"
          class="widget-toggle-checkbox-hidden"
          data-widget-toggle="monthly_load"
          {% if dashboard_widget_state['monthly_load']|default(true) %}checked{% endif %}
        >
      </div>
    </div>
    <div class="chart-wrap" id="projections-wrap" data-widget="projections">
      <div class="chart-title">Temps projetés — basé sur tes 5 dernières sorties</div>
      <div id="projections-grid" class="projections-grid"></div>
      <template id="projection-card-template">
        <article class="proj-card">
          <div class="proj-label"></div>
          <div class="proj-time"></div>
          <div class="proj-pace"></div>
        </article>
      </template>
      <template id="projection-empty-template">
        <div class="empty-hint">Pas encore assez de données.</div>
      </template>
      <div id="projections-meta" class="meta-small"></div>
    </div>
    <div class="chart-wrap" id="ef-bpm-wrap" data-widget="ef_bpm">
      <div class="chart-title">Suivi BPM — Endurance Fondamentale</div>
      <div id="ef-bpm-chart-container" class="ef-bpm-chart-container"></div>
    </div>
    <div class="chart-wrap" id="training-load-wrap" data-widget="training_load">
      <div class="chart-title">Charge d'entrainement</div>
      <div class="training-load-head">
        <span id="training-load-status" class="training-load-status">Initialisation</span>
        <span id="training-load-ratio" class="training-load-ratio">Ratio —</span>
      </div>
      <div class="training-load-kpis">
        <div class="training-load-kpi"><span>7 jours</span><strong id="training-load-acute">—</strong></div>
        <div class="training-load-kpi"><span>Base 28j/4</span><strong id="training-load-chronic">—</strong></div>
        <div class="training-load-kpi"><span>Ecart</span><strong id="training-load-delta">—</strong></div>
      </div>
      <div id="training-load-reco" class="training-load-reco"></div>
      <div id="training-load-chart" class="training-load-chart"></div>
    </div>
    <div class="progress-section" data-widget="plan_progress">
      <div class="chart-title">Suivi des plans</div>
      <div class="plan-progress-list" id="plan-progress-list"></div>
      <div class="plan-progress-hidden" id="plan-progress-hidden"></div>
      <template id="plan-progress-card-template">
        <article class="plan-progress-card">
          <div class="plan-progress-card-head">
            <div class="plan-progress-card-heading">
              <div class="plan-progress-card-title"></div>
              <div class="plan-progress-card-pct"></div>
            </div>
            <button type="button" class="plan-progress-card-action"></button>
          </div>
          <div class="plan-progress-card-bar"><div class="plan-progress-card-fill"></div></div>
          <div class="plan-progress-card-meta"></div>
        </article>
      </template>
      <template id="plan-progress-hidden-button-template">
        <button type="button" class="plan-progress-hidden-btn"></button>
      </template>
    </div>

    <div class="chart-wrap" data-widget="monthly_load">
      <div class="chart-title">Kilométrage mensuel (2026)</div>
      <div class="bar-chart" id="monthly-chart"></div>
      <template id="monthly-bar-template">
        <article class="bar-col">
          <div class="bar"><span class="bar-value" aria-hidden="true"></span></div>
          <div class="bar-label"></div>
        </article>
      </template>
    </div>

    <div id="coherence-section" data-widget="coherence"></div>
    <template id="coherence-alert-template">
      <div class="alert">
        <div class="alert-title"></div>
        <p class="alert-body"></p>
        <button type="button" class="alert-detail-toggle" hidden></button>
        <div class="alert-details" hidden></div>
      </div>
    </template>

  </section>
</main>

<div class="notif" id="notif"></div>
<div class="confirm-overlay" id="confirm-overlay">
  <div class="modal">
    <div class="modal-title" id="confirm-title">Confirmation</div>
    <div id="confirm-msg"></div>
    <div class="modal-actions">
      <button class="btn" onclick="confirmDelete()">Confirmer</button>
      <button class="btn btn-ghost" onclick="closeConfirm()">Annuler</button>
    </div>
  </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/app.js') }}?v=20260526-metadatafix2"></script>
{% endblock %}
