{% extends 'base/layout.html.twig' %}
{% block title %}Accueil - Running Tracker{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/shell.css') }}?v=20260521-mobile1">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=20260616-p2p4">
  <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}?v=20260609-calendarlogs1">
<link rel="stylesheet" href="{{ asset('css/home.css') }}?v=20260615-calviews7">
{% endblock %}

{% block body %}
{% include 'components/_app_header.html.twig' with { current_page: 'home', username: username } %}

<main>
  <section id="dashboard" class="visible">
    <div class="dashboard-topline">
      <div class="dashboard-intro">
        <div class="section-title">Accueil</div>
        <div class="section-sub" id="dash-date">Chargement…</div>
      </div>
      <div id="dashboard-weather">
        {% if initialWeatherAdvice is defined and initialWeatherAdvice %}
          <article class="advice-card advice-info" data-server-fallback="1">
            <div class="advice-icon-group">
              <div class="advice-icon">{{ initialWeatherAdvice.icon|default('🌤️') }}</div>
              {% if initialWeatherAdvice.tempMin is defined or initialWeatherAdvice.tempMax is defined %}<div class="advice-temps">{% if initialWeatherAdvice.tempMin is not null %}{{ initialWeatherAdvice.tempMin|round(0) }}°{% else %}—{% endif %} / {% if initialWeatherAdvice.tempMax is not null %}{{ initialWeatherAdvice.tempMax|round(0) }}°{% else %}—{% endif %}</div>{% endif %}
            </div>
            <div class="advice-content">
              <h4 class="advice-title">{{ initialWeatherAdvice.title|default('Conseil meteo du jour') }}</h4>
              <div class="advice-meta">
                <span class="advice-badge">{{ initialWeatherAdvice.badge|default('Auto') }}</span>
              </div>
              <p class="advice-text">{{ initialWeatherAdvice.text|default('Meteo variable: tu peux adapter l\'allure a la sensation du jour et prevoir une hydratation adaptee.') }}</p>
            </div>
          </article>
        {% endif %}
      </div>
    </div>

    <div id="dashboard-advice"></div>
    <template id="dashboard-advice-stack-template">
      <div class="advice-stack"></div>
    </template>
    <template id="dashboard-advice-item-template">
      <article class="advice-card">
        <div class="advice-icon-group">
          <div class="advice-icon"></div>
          <div class="advice-temps"></div>
        </div>
        <div class="advice-content">
          <h4 class="advice-title">Conseil du jour</h4>
          <div class="advice-meta"><span class="advice-badge"></span></div>
          <p class="advice-text"></p>
        </div>
      </article>
    </template>

    <section class="progress-section home-plan-module" id="home-plan-module">
      <button type="button" class="home-plan-module-toggle" id="home-plan-module-toggle" aria-expanded="true" aria-controls="home-plan-module-content">
        <span class="home-plan-module-toggle-label">Suivi des plans</span>
        <span class="home-plan-module-toggle-icon" aria-hidden="true">▾</span>
      </button>
      <div class="home-plan-module-content" id="home-plan-module-content">
        <div class="plan-progress-list" id="plan-progress-list"></div>
        <div class="plan-progress-hidden" id="plan-progress-hidden"></div>
        <template id="plan-progress-card-template">
          <article class="plan-progress-card">
            <div class="plan-progress-card-head">
              <div class="plan-progress-card-heading">
                <div class="plan-progress-card-title"></div>
                <div class="plan-progress-card-pct"></div>
              </div>
              <button type="button" class="plan-progress-card-action"></button>
            </div>
            <div class="plan-progress-card-bar"><div class="plan-progress-card-fill"></div></div>
            <div class="plan-progress-card-meta"></div>
          </article>
        </template>
        <template id="plan-progress-hidden-button-template">
          <button type="button" class="plan-progress-hidden-btn"></button>
        </template>
      </div>
    </section>

    <div class="cal-view-header" id="cal-view-header">
      <div class="cal-view-toggle" id="cal-view-toggle" role="group" aria-label="Vue calendrier">
        <button class="cal-view-btn" data-view="month" type="button">Mois</button>
        <button class="cal-view-btn" data-view="week" type="button">Semaine</button>
        <button class="cal-view-btn" data-view="day" type="button">Jour</button>
      </div>
    </div>

    <div id="home-week-strip" class="home-week-strip" hidden></div>
    <div id="home-day-view" class="home-day-view" hidden></div>

    <div class="chart-wrap plan-calendar-wrap" id="plan-calendar-wrap">
      <div class="plan-calendar-head">
        <div class="plan-calendar-topline">
          <div class="chart-title" id="plan-calendar-title">Calendrier des séances prévues</div>
          <div class="plan-calendar-summary" id="plan-calendar-summary">—</div>
        </div>
        <div class="plan-calendar-month-nav">
          <button class="plan-calendar-nav-btn" id="plan-calendar-prev" type="button" aria-label="Mois précédent">‹</button>
          <div class="plan-calendar-month" id="plan-calendar-month">—</div>
          <button class="plan-calendar-nav-btn" id="plan-calendar-next" type="button" aria-label="Mois suivant">›</button>
        </div>
      </div>
      <div class="plan-calendar-scroll">
        <div class="plan-calendar-weekdays" aria-hidden="true">
          <span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span>
        </div>
        <div class="plan-calendar-grid" id="plan-calendar-grid"></div>
      </div>
      <div class="plan-calendar-empty" id="plan-calendar-empty"></div>
    </div>

    <div class="table-wrap">
      <div class="table-header">📅 Prochaines courses</div>
      <table>
        <thead><tr><th>Course</th><th>Date</th><th>Distance</th><th>Statut</th></tr></thead>
        <tbody id="race-tbody"></tbody>
      </table>
      <template id="dashboard-race-row-template">
        <tr>
          <td class="dashboard-race-name"></td>
          <td class="mono dashboard-race-date"></td>
          <td class="dashboard-race-dist"></td>
          <td><span class="badge dashboard-race-status"></span></td>
        </tr>
      </template>
    </div>
  </section>
</main>

<div class="notif" id="notif"></div>

<div class="modal-overlay" id="weather-city-modal" aria-hidden="true">
  <div class="modal weather-city-modal" aria-labelledby="weather-city-modal-title">
    <button class="modal-close" id="weather-city-close" type="button" aria-label="Fermer">✕</button>
    <div class="modal-title" id="weather-city-modal-title">Choisir la ville meteo</div>
    <div class="weather-city-modal-form">
      <div class="weather-city-current-applied" id="weather-city-current-applied">Actuellement: Auto</div>
      <label for="weather-city-input">Ville</label>
      <input id="weather-city-input" type="text" placeholder="Ex: Lyon" maxlength="80">
      <div class="weather-city-suggestion" id="weather-city-suggestion" hidden>
        <button class="btn btn-ghost weather-city-use-detected" id="weather-city-use-detected" type="button"></button>
      </div>
    </div>
    <div class="modal-actions weather-city-modal-actions">
      <button class="btn" id="weather-city-apply" type="button">Appliquer</button>
      <button class="btn btn-ghost" id="weather-city-reset" type="button">Auto</button>
    </div>
  </div>
</div>
{% endblock %}

