<header class="app-header">
  <div class="header-left">
    <div class="logo">RUN<span>/</span>TRACKER</div>
    {% include 'components/_theme_toggle.html.twig' with { with_onclick: true } %}
  </div>
  <button
    class="mobile-nav-toggle"
    id="mobile-nav-toggle"
    type="button"
    aria-label="Ouvrir le menu"
    aria-expanded="false"
    aria-controls="app-nav"
  >
    <span class="mobile-nav-toggle-bar"></span>
    <span class="mobile-nav-toggle-bar"></span>
    <span class="mobile-nav-toggle-bar"></span>
  </button>
  <nav id="app-nav" class="app-nav" aria-label="Navigation principale">
    <a href="{{ path('app_home') }}" class="nav-link{{ current_page == 'home' ? ' active' : '' }}">Accueil</a>
    <a href="{{ path('app_dashboard') }}" class="nav-link{{ current_page == 'dashboard' ? ' active' : '' }}">Dashboard</a>
    <a href="{{ path('app_plans') }}" class="nav-link{{ current_page == 'plans' ? ' active' : '' }}">Plans</a>
    <a href="{{ path('app_log') }}" class="nav-link{{ current_page == 'log' ? ' active' : '' }}">Log</a>
    <a href="{{ path('app_courses') }}" class="nav-link{{ current_page == 'courses' ? ' active' : '' }}">Courses</a>
    <a
      id="admin-nav-link"
      href="{{ path('app_admin_users') }}"
      class="nav-link{{ current_page == 'admin_users' ? ' active' : '' }}"
      {% if not is_granted('ROLE_ADMIN') %}hidden{% endif %}
    >Admin</a>
  </nav>
  <div class="user-badge">
    <span class="user-greeting">Bienvenue,</span>
    <strong id="current-username" class="current-username">{{ username ?: 'inconnu' }}</strong>
    <button class="logout-btn" type="button" onclick="logout()" title="Déconnexion" aria-label="Déconnexion">
      <span class="logout-icon" aria-hidden="true">⏻</span>
    </button>
  </div>
</header>

{% set announcement = active_admin_announcement() %}
{% if announcement %}
  <output class="global-announcement announcement-{{ announcement.level|default('info') }}" aria-live="polite">
    <div class="global-announcement-inner">
      <span class="global-announcement-label">Annonce</span>
      <span>{{ announcement.message }}</span>
      {% if announcement.endsAt %}
        <span class="global-announcement-expiry">Jusqu'au {{ announcement.endsAt }}</span>
      {% endif %}
    </div>
  </output>
{% endif %}
