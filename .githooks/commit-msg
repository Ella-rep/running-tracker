#!/bin/bash
# .git/hooks/commit-msg
# Vérifie le format du commit, gère le bump, supprime [bump:xxx], et ne s'exécute que sur develop

set -euo pipefail

# -------------------------------
# 0️⃣ Vérifier la branche courante
# -------------------------------
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "develop" ]; then
    echo "ℹ️ Hook bump ignoré (branche actuelle : $BRANCH, actif uniquement sur develop)."
    exit 0
fi

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# -------------------------------
# 1️⃣ Vérification du format
# -------------------------------
echo "----------------------------------------"
echo "📌 Conventions de nommage des commits :"
echo "Format attendu : type: description courte"
echo "Types autorisés : feat, fix, docs, style, refactor, perf, test, chore"
echo "Exemple : feat: ajout de la recherche avancée"
echo "----------------------------------------"

if ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore): .+'; then
    echo "❌ Erreur : le message de commit ne respecte pas la convention."
    exit 1
fi

# -------------------------------
# 2️⃣ Vérification de composer.json
# -------------------------------
if ! command -v jq >/dev/null 2>&1; then
    echo "❌ Erreur : 'jq' est requis. Installez-le avec 'sudo apt install jq' ou 'brew install jq'."
    exit 1
fi

if [ ! -f composer.json ]; then
    echo "❌ Erreur : composer.json introuvable."
    exit 1
fi

CURRENT_VERSION=$(jq -r '.version' composer.json)
if [ "$CURRENT_VERSION" == "null" ]; then
    echo "❌ Erreur : aucun champ 'version' trouvé dans composer.json"
    exit 1
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"

# -------------------------------
# 3️⃣ Détection automatique ou forcée
# -------------------------------
if echo "$COMMIT_MSG" | grep -qE "BREAKING CHANGE|major"; then
    TYPE="major"
elif echo "$COMMIT_MSG" | grep -qE "^feat|minor"; then
    TYPE="minor"
elif echo "$COMMIT_MSG" | grep -qE "^fix|patch"; then
    TYPE="patch"
elif echo "$COMMIT_MSG" | grep -qE "\[bump:(major|minor|patch|none)\]"; then
    TYPE=$(echo "$COMMIT_MSG" | grep -oE "\[bump:(major|minor|patch|none)\]" | sed 's/\[bump://;s/\]//')
else
    TYPE="none"
fi

# -------------------------------
# 4️⃣ Suppression des tags [bump:xxx] du message final
# -------------------------------
sed -i -E 's/\[bump:(major|minor|patch|none)\]//g' "$COMMIT_MSG_FILE"
sed -i -E 's/[[:space:]]+$//' "$COMMIT_MSG_FILE"

# -------------------------------
# 5️⃣ Mode strict avec "none" volontaire
# -------------------------------
if [ "$TYPE" = "none" ]; then
    if echo "$COMMIT_MSG" | grep -q "\[bump:none\]"; then
        echo "ℹ️ Commit autorisé sans bump (bump:none explicite)."
        exit 0
    fi
    echo "❌ Aucun changement de version détecté automatiquement."
    echo "💡 Pour forcer un bump avec commit -m, ajoute à ton message :"
    echo "    [bump:patch]  → incrémente patch"
    echo "    [bump:minor]  → incrémente minor"
    echo "    [bump:major]  → incrémente major"
    echo "💡 Pour autoriser un commit sans bump, ajoute :"
    echo "    [bump:none]"
    echo "💡 Ou fais un commit sans -m pour choisir interactivement :"
    echo "    git commit"
    exit 1
fi

# -------------------------------
# 6️⃣ Application du bump
# -------------------------------
case $TYPE in
    major)
        MAJOR=$((MAJOR + 1))
        MINOR=0
        PATCH=0
        ;;
    minor)
        MINOR=$((MINOR + 1))
        PATCH=0
        ;;
    patch)
        PATCH=$((PATCH + 1))
        ;;
esac

NEW_VERSION="$MAJOR.$MINOR.$PATCH"

# -------------------------------
# 7️⃣ Mise à jour de composer.json
# -------------------------------
jq --arg v "$NEW_VERSION" '.version = $v' composer.json > composer.json.tmp && mv composer.json.tmp composer.json

git add composer.json

echo "✅ Version mise à jour : $CURRENT_VERSION → $NEW_VERSION"
